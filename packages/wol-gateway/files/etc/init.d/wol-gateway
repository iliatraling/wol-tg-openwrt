#!/bin/sh /etc/rc.common
# procd-служба Telegram WOL Gateway.

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/wol-gateway
    procd_set_param env WOL_CONFIG=/etc/wol-gateway.env
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
