# Telegram Bot API
# Replace this placeholder with the token issued by @BotFather.
# Never commit or share your real token.
BOT_TOKEN="PUT_TELEGRAM_BOT_TOKEN_HERE"

# Allowed Telegram User IDs, separated by commas.
# Replace this documentation-only ID with your own numeric Telegram User ID.
ALLOWED_USER_IDS="1234567890"

# Device lists must contain the same number of items in the same order.
# TARGET_NAMES: unique command aliases; lowercase letters, digits and hyphens only.
TARGET_NAMES="test-pc,test-nas"

# TARGET_LABELS: human-readable device names shown in Telegram.
TARGET_LABELS="Test PC,Test NAS"

# TARGET_MACS: documentation-only locally administered unicast MAC addresses.
# Replace them with the actual MAC addresses of your WOL devices.
TARGET_MACS="02:00:00:00:00:01,02:00:00:00:00:02"

# TARGET_IPS: documentation-only TEST-NET IPv4 addresses used for ping.
# Use 0 when an IP address is not configured.
TARGET_IPS="192.0.2.10,198.51.100.20"

# Device aliases used by /wake and /status when no argument is provided.
# Set one alias or multiple comma-separated aliases.
DEFAULT_TARGETS="test-pc,test-nas"

# OpenWrt LAN interface used to send Wake-on-LAN magic packets.
NETWORK_INTERFACE="br-lan"
