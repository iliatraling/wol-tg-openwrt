# Telegram Bot API
# Set the token locally on the router. Never commit or share it.
BOT_TOKEN="PUT_TELEGRAM_BOT_TOKEN_HERE"

# Allowed Telegram User IDs, separated by commas.
ALLOWED_USER_IDS="422503387"

# Device lists must contain the same number of items in the same order.
# TARGET_NAMES: unique command aliases; use lowercase letters, digits and hyphens only.
TARGET_NAMES="home,work"

# TARGET_LABELS: human-readable device names shown in Telegram.
TARGET_LABELS="Home PC,Work PC"

# TARGET_MACS: device MAC addresses used to send Wake-on-LAN magic packets.
TARGET_MACS="18:C0:4D:6E:81:5D,AA:BB:CC:DD:EE:FF"

# TARGET_IPS: IPv4 addresses used for ping; use 0 when an IP address is not configured.
TARGET_IPS="192.168.0.134,0"

# Device aliases used by /wake and /status when no argument is provided.
# Set one alias or multiple comma-separated aliases.
DEFAULT_TARGETS="home,work"

# OpenWrt LAN interface used to send Wake-on-LAN magic packets.
NETWORK_INTERFACE="br-lan"
