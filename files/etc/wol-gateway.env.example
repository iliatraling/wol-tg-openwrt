# Telegram Bot API
# Укажите токен локально на роутере. Не публикуйте его в Git.
BOT_TOKEN="PUT_TELEGRAM_BOT_TOKEN_HERE"

# Разрешённые Telegram User ID через запятую
ALLOWED_USER_IDS="422503387"

# Списки устройств. Порядок элементов во всех четырёх списках должен совпадать.
# TARGET_NAMES: уникальные алиасы для команд, только a-z, 0-9 и дефис.
TARGET_NAMES="home,work"

# TARGET_LABELS: отображаемые имена устройств.
TARGET_LABELS="Домашний ПК,Рабочий ПК"

# TARGET_MACS: MAC-адреса для отправки Magic Packet.
TARGET_MACS="18:C0:4D:6E:81:5D,AA:BB:CC:DD:EE:FF"

# TARGET_IPS: IPv4 для ping; 0 означает, что IP не задан.
TARGET_IPS="192.168.0.134,0"

# Алиасы устройств, используемые командами /wake и /status без аргумента.
# Можно указать один алиас или несколько через запятую.
DEFAULT_TARGETS="home,work"

# LAN-интерфейс OpenWrt для отправки Magic Packet.
NETWORK_INTERFACE="br-lan"
